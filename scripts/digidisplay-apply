#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"
# shellcheck source=scripts/lib/digidisplay-local-runtime
source "$REPO_DIR/scripts/lib/digidisplay-local-runtime"

SERVICE_TEMPLATE="$REPO_DIR/systemd/digidisplay-user.service"
USER_SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
USER_SERVICE_FILE="$USER_SYSTEMD_DIR/$SERVICE_NAME"
FIREFOX_PROFILE_DIR="${DIGIDISPLAY_FIREFOX_PROFILE:-$HOME/.local/share/digidisplay/firefox-profile}"
FIREFOX_PREFS_SOURCE="$REPO_DIR/config/firefox/user.js"
WALLPAPER_SOURCE="$REPO_DIR/assets/wallpaper/digidisplay-wallpaper.jpg"
WALLPAPER_DEST="$HOME/.local/share/digidisplay/wallpaper.jpg"
PLASMA_KEYBOARD_DESKTOP="${DIGIDISPLAY_PLASMA_KEYBOARD_DESKTOP:-/usr/share/applications/org.kde.plasma.keyboard.desktop}"
KRDP_DROPIN_DIR="/etc/systemd/user/app-org.kde.krdpserver.service.d"

check_environment() {
  if [ -r /etc/os-release ]; then
    if ! grep -Eiq 'aurora|universal.blue|ublue' /etc/os-release; then
      warn "This does not look like Aurora DX. Apply will continue, but DigiDisplay is intended for Aurora DX."
    fi
  else
    warn "Could not read /etc/os-release to verify Aurora DX."
  fi

  command -v python3 >/dev/null 2>&1 || fail "python3 is required to read $(show_path "$CONFIG_FILE")."
  command -v systemctl >/dev/null 2>&1 || fail "systemctl is required for the systemd user service."
}

check_local_requirements() {
  command -v git >/dev/null 2>&1 || fail "git is required for local mode."
  command -v docker >/dev/null 2>&1 || fail "docker is required for local mode."
  command -v curl >/dev/null 2>&1 || fail "curl is required for local mode."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose is not available."
}

ensure_firefox() {
  command -v firefox >/dev/null 2>&1 && return
  command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1 && return
  fail "Firefox was not found. Install Firefox, then run 'just apply' again."
}

kwriteconfig() {
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 "$@"
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig5 "$@"
  else
    return 127
  fi
}

has_kwriteconfig() {
  command -v kwriteconfig6 >/dev/null 2>&1 || command -v kwriteconfig5 >/dev/null 2>&1
}

# Asks for the sudo password once, at the start, when a later step needs it.
# sudo then remembers it for the rest of apply.
request_sudo_if_needed() {
  local needs_sudo="false"

  if [ -n "$DD_HOSTNAME" ] && [ "$DD_HOSTNAME" != "$(hostname)" ]; then
    needs_sudo="true"
  fi
  [ "$DD_REMOTE_ADMIN_SSH" = "true" ] && needs_sudo="true"
  [ "$DD_AUTOLOGIN" = "true" ] && needs_sudo="true"
  [ "$DD_REMOTE_ADMIN_RDP" = "true" ] && needs_sudo="true"

  [ "$needs_sudo" = "true" ] || return 0
  log "Some settings need administrator rights. Enter your password once."
  sudo -v || fail "Could not get administrator rights. Nothing was changed."
}

configure_hostname() {
  [ -n "$DD_HOSTNAME" ] || return 0
  [ "$DD_HOSTNAME" != "$(hostname)" ] || return 0
  command -v hostnamectl >/dev/null 2>&1 || fail "hostnamectl is required to change the hostname."
  sudo hostnamectl set-hostname "$DD_HOSTNAME"
}

enable_ssh() {
  sudo systemctl enable --now sshd.service
  warn "SSH is enabled for this device. Keep it limited to trusted networks."
}

# KRDP ships NoNewPrivileges=true, which blocks the SELinux transition PAM needs
# for password checks, so RDP logins always fail. /usr is read-only, so the
# override goes in /etc.
enable_rdp_fix() {
  sudo mkdir -p "$KRDP_DROPIN_DIR"
  printf '[Service]\nNoNewPrivileges=false\n' | sudo tee "$KRDP_DROPIN_DIR/override.conf" >/dev/null
  systemctl --user daemon-reload
  systemctl --user restart app-org.kde.krdpserver.service || warn "Could not restart the KRDP server. It will use the fix after the next login."
}

install_firefox_profile() {
  mkdir -p "$FIREFOX_PROFILE_DIR"
  cp "$FIREFOX_PREFS_SOURCE" "$FIREFOX_PROFILE_DIR/user.js"

  if command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
    mkdir -p "$HOME/.var/app/org.mozilla.firefox/digidisplay-profile"
    cp "$FIREFOX_PREFS_SOURCE" "$HOME/.var/app/org.mozilla.firefox/digidisplay-profile/user.js"
  fi
}

install_user_service() {
  local restart_policy="no"
  local escaped_config_file
  local escaped_repo_dir

  [ "$DD_RESTART_BROWSER" = "true" ] && restart_policy="always"
  escaped_config_file="$(printf '%s' "$CONFIG_FILE" | sed 's/[&|]/\\&/g')"
  escaped_repo_dir="$(printf '%s' "$REPO_DIR" | sed 's/[&|]/\\&/g')"

  mkdir -p "$USER_SYSTEMD_DIR"
  sed \
    -e "s|@CONFIG_FILE@|$escaped_config_file|g" \
    -e "s|@REPO_DIR@|$escaped_repo_dir|g" \
    -e "s|@RESTART_POLICY@|$restart_policy|g" \
    "$SERVICE_TEMPLATE" > "$USER_SERVICE_FILE"

  systemctl --user daemon-reload
  systemctl --user enable "$SERVICE_NAME"
}

# idle_lock_minutes 0 keeps the screen unlocked (signage, terminal); above 0 locks it (workstation).
configure_kde_locking() {
  has_kwriteconfig || { warn "KDE screen-lock settings were not changed because kwriteconfig was not found."; return; }

  if [ "$DD_IDLE_LOCK_MINUTES" -gt 0 ]; then
    kwriteconfig --file kscreenlockerrc --group Daemon --key Autolock true
    kwriteconfig --file kscreenlockerrc --group Daemon --key Timeout "$DD_IDLE_LOCK_MINUTES"
    kwriteconfig --file kscreenlockerrc --group Daemon --key LockOnResume true
    log "Screen locks after $DD_IDLE_LOCK_MINUTES idle minutes."
  else
    kwriteconfig --file kscreenlockerrc --group Daemon --key Autolock false
    kwriteconfig --file kscreenlockerrc --group Daemon --key LockOnResume false
  fi
}

configure_kde_power_management() {
  local profile

  has_kwriteconfig || { warn "KDE power-management settings were not changed because kwriteconfig was not found."; return; }

  for profile in AC Battery LowBattery; do
    kwriteconfig --file powerdevilrc --group "$profile" --group Display --key DimDisplayWhenIdle false
    kwriteconfig --file powerdevilrc --group "$profile" --group Display --key DimDisplayIdleTimeoutSec 0
    kwriteconfig --file powerdevilrc --group "$profile" --group Display --key TurnOffDisplayWhenIdle false
    kwriteconfig --file powerdevilrc --group "$profile" --group Display --key TurnOffDisplayIdleTimeoutSec 0
    kwriteconfig --file powerdevilrc --group "$profile" --group Display --key LockBeforeTurnOffDisplay false
    kwriteconfig --file powerdevilrc --group "$profile" --group SuspendAndShutdown --key AutoSuspendIdleTimeoutSec 0
  done

  if systemctl --user list-unit-files plasma-powerdevil.service >/dev/null 2>&1; then
    systemctl --user restart plasma-powerdevil.service || warn "Could not restart plasma-powerdevil.service. Power settings will apply after next login."
  fi
}

# off: no input method. on_touch: Plasma Keyboard in automatic mode. always: always visible.
configure_kde_virtual_keyboard() {
  command -v kwriteconfig6 >/dev/null 2>&1 || { warn "Virtual-keyboard settings were not changed because kwriteconfig6 was not found."; return; }

  if [ "$DD_VIRTUAL_KEYBOARD" = "off" ]; then
    kwriteconfig6 --file kwinrc --group Wayland --key InputMethod --delete
    kwriteconfig6 --file kwinrc --group Wayland --key VirtualKeyboardMode 1
    return
  fi

  [ -f "$PLASMA_KEYBOARD_DESKTOP" ] || { warn "Plasma Keyboard was not found. Update Aurora or install plasma-keyboard to enable it."; return; }
  kwriteconfig6 --file kwinrc --group Wayland --key InputMethod "$PLASMA_KEYBOARD_DESKTOP"
  if [ "$DD_VIRTUAL_KEYBOARD" = "always" ]; then
    kwriteconfig6 --file kwinrc --group Wayland --key VirtualKeyboardMode 2
  else
    kwriteconfig6 --file kwinrc --group Wayland --key VirtualKeyboardMode 1
  fi
}

configure_kde_menu_visibility() {
  local plasmashell_config="$HOME/.config/plasmashellrc"
  local panel_visibility="0"
  local panel_group
  local panel_subgroup
  local panel_groups

  [ "$DD_HIDE_MENU" = "true" ] && panel_visibility="1"
  has_kwriteconfig || { warn "Plasma panel visibility was not changed because kwriteconfig was not found."; return; }

  if [ ! -f "$plasmashell_config" ]; then
    warn "Plasma panel visibility was not changed because $(show_path "$plasmashell_config") does not exist yet. Log in to Plasma once, then re-run apply."
    return
  fi

  panel_groups="$(awk '
    /^\[PlasmaViews\]\[Panel [0-9]+\]$/ {
      split($0, parts, /[][]/)
      print parts[3] "\t"
    }
    /^\[PlasmaViews\]\[Panel [0-9]+\]\[Horizontal[0-9]+\]$/ {
      split($0, parts, /[][]/)
      print parts[3] "\t" parts[4]
    }
  ' "$plasmashell_config")"

  if [ -z "$panel_groups" ]; then
    warn "No Plasma panels were found in $(show_path "$plasmashell_config")."
    return
  fi

  while IFS=$'\t' read -r panel_group panel_subgroup; do
    [ -n "$panel_group" ] || continue
    if [ -n "$panel_subgroup" ]; then
      kwriteconfig --file plasmashellrc --group PlasmaViews --group "$panel_group" --group "$panel_subgroup" --key panelVisibility "$panel_visibility"
    else
      kwriteconfig --file plasmashellrc --group PlasmaViews --group "$panel_group" --key panelVisibility "$panel_visibility"
    fi
  done <<< "$panel_groups"

  if systemctl --user is-active --quiet plasma-plasmashell.service 2>/dev/null; then
    systemctl --user restart plasma-plasmashell.service || warn "Plasma panel visibility was saved, but the Plasma shell could not be restarted. Log out and back in or reboot to apply it."
  else
    warn "Plasma panel visibility was saved. Log out and back in or reboot if the panel does not change immediately."
  fi
}

install_wallpaper() {
  [ -f "$WALLPAPER_SOURCE" ] || return 0

  mkdir -p "$(dirname "$WALLPAPER_DEST")"
  cp "$WALLPAPER_SOURCE" "$WALLPAPER_DEST"

  if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    plasma-apply-wallpaperimage --fill-mode preserveAspectCrop "$WALLPAPER_DEST" >/dev/null 2>&1 \
      || warn "Could not set the desktop wallpaper automatically. You can set it manually via System Settings."
  else
    warn "plasma-apply-wallpaperimage was not found. Skipping automatic wallpaper setup."
  fi
}

detect_login_manager() {
  case "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)" in
    */plasmalogin.service) printf 'plasmalogin\n' ;;
    */sddm.service) printf 'sddm\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

configure_autologin() {
  local conf_dir
  local tmp_file

  case "$(detect_login_manager)" in
    plasmalogin) conf_dir="/etc/plasmalogin.conf.d" ;;
    sddm) conf_dir="/etc/sddm.conf.d" ;;
    *) fail "Could not detect sddm or plasmalogin as the active login manager." ;;
  esac

  tmp_file="$(mktemp)"
  printf '[Autologin]\nUser=%s\nSession=plasma.desktop\n' "$USER" > "$tmp_file"
  sudo mkdir -p "$conf_dir"
  sudo cp "$tmp_file" "$conf_dir/digidisplay-autologin.conf"
  rm -f -- "$tmp_file"
}

main() {
  log "DigiDisplay apply"
  log "Configuration: $(show_path "$CONFIG_FILE")"

  check_environment
  load_settings
  request_sudo_if_needed
  protect_config_files
  log "Profile: $DD_PROFILE, mode: $DD_MODE"

  if [ "$DD_MODE" = "local" ]; then
    check_local_requirements
    install_deploy_key
  fi
  ensure_firefox

  configure_hostname
  [ "$DD_REMOTE_ADMIN_SSH" = "true" ] && enable_ssh
  install_firefox_profile
  install_user_service
  configure_kde_locking
  configure_kde_power_management
  configure_kde_virtual_keyboard
  configure_kde_menu_visibility
  install_wallpaper
  [ "$DD_AUTOLOGIN" = "true" ] && configure_autologin
  [ "$DD_REMOTE_ADMIN_RDP" = "true" ] && enable_rdp_fix

  systemctl --user restart "$SERVICE_NAME"

  log "Configuration applied. Run 'just status' to check the kiosk."

  if [ "$DD_REBOOT_AFTER_APPLY" = "true" ]; then
    log "Rebooting as requested by reboot_after_apply."
    systemctl reboot
  fi
}

main "$@"
