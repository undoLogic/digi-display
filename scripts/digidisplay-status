#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"

log "DigiDisplay status"
log "Config file: $(show_path "$CONFIG_FILE")"
log "Backups: $(show_path "$BACKUP_DIR")/"
log "Cloud server: $SERVER_URL"
log

if [ -f "$CONFIG_FILE" ]; then
  python3 "$CONFIG_LIB" explain || true
else
  log "Config file does not exist yet. Run 'just init' or 'just login'."
fi

log
log "Service enabled: $(systemctl --user is-enabled "$SERVICE_NAME" 2>/dev/null || true)"
log "Service active: $(systemctl --user is-active "$SERVICE_NAME" 2>/dev/null || true)"
log
log "Recent logs:"
journalctl --user -u "$SERVICE_NAME" -n 30 --no-pager || true
