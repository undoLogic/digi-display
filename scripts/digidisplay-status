#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="${DIGIDISPLAY_CONFIG:-$HOME/digidisplay.json}"
SERVICE_NAME="digidisplay.service"

log() {
  printf '%s\n' "$*"
}

json_value() {
  local key="$1"
  local fallback="$2"

  if [ ! -f "$CONFIG_FILE" ]; then
    printf '%s\n' "$fallback"
    return
  fi

  python3 - "$CONFIG_FILE" "$key" "$fallback" <<'PY'
import json
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
key = sys.argv[2]
fallback = sys.argv[3]

try:
    data = json.loads(config_path.read_text())
except Exception:
    print(fallback)
    raise SystemExit

value = data.get(key, fallback)
if value is None:
    value = fallback
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

log "DigiDisplay status"
log
log "Config file: $CONFIG_FILE"

if [ -f "$CONFIG_FILE" ]; then
  log "URL: $(json_value "url" "not configured")"
  log "Kiosk: $(json_value "kiosk" "true")"
  log "Restart browser: $(json_value "restart_browser" "true")"
else
  log "Config file does not exist yet."
fi

log

if command -v systemctl >/dev/null 2>&1; then
  log "Service enabled: $(systemctl --user is-enabled "$SERVICE_NAME" 2>/dev/null || true)"
  log "Service active: $(systemctl --user is-active "$SERVICE_NAME" 2>/dev/null || true)"
  log
  systemctl --user --no-pager --full status "$SERVICE_NAME" || true
  log
  log "Recent logs:"
  journalctl --user -u "$SERVICE_NAME" -n 30 --no-pager || true
else
  log "systemctl is not available."
fi
