#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="${DIGIDISPLAY_CONFIG:-$HOME/digidisplay.json}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
CONFIG_TEMPLATE="$REPO_DIR/config/digidisplay.json.example"

log() {
  printf '%s\n' "$*"
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

[ -f "$CONFIG_TEMPLATE" ] || fail "Configuration template was not found: $CONFIG_TEMPLATE"
[ ! -e "$CONFIG_FILE" ] || fail "Configuration already exists: $CONFIG_FILE. Edit it or back it up before retrying."

python3 - "$CONFIG_TEMPLATE" <<'PY'
import json
import sys

with open(sys.argv[1]) as config_file:
    config = json.load(config_file)

if not isinstance(config, dict):
    raise SystemExit("The configuration template must contain a JSON object.")
PY

mkdir -p "$(dirname "$CONFIG_FILE")"
cp -- "$CONFIG_TEMPLATE" "$CONFIG_FILE"
log "Created DigiDisplay configuration: $CONFIG_FILE"
log "Edit the file, then run 'just digidisplay-apply'."
