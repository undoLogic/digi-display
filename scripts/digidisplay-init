#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"

usage() {
  fail "Usage: just init [signage|terminal|workstation] [--advanced]"
}

main() {
  local profile="signage"
  local advanced=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      --advanced) advanced=(--advanced) ;;
      signage|terminal|workstation) profile="$arg" ;;
      *) usage ;;
    esac
  done

  if [ -e "$CONFIG_FILE" ]; then
    printf 'ERROR: A configuration already exists: %s\n' "$(show_path "$CONFIG_FILE")" >&2
    printf '  Edit it:     nano %s\n' "$(show_path "$CONFIG_FILE")" >&2
    printf '  Start over:  mkdir -p %s && mv %s %s/\n' "$(show_path "$BACKUP_DIR")" "$(show_path "$CONFIG_FILE")" "$(show_path "$BACKUP_DIR")" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$CONFIG_FILE")"
  (umask 077 && python3 "$CONFIG_LIB" template "$profile" "${advanced[@]}" > "$CONFIG_FILE")

  log "Created $(show_path "$CONFIG_FILE") ($profile profile)."
  log "Review it, then run: just apply"
}

main "$@"
