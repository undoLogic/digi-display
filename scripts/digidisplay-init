#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"

usage() {
  fail "Usage: just init [signage|terminal|workstation] [--advanced]"
}

main() {
  local profile="signage"
  local advanced=()
  local arg

  for arg in "$@"; do
    case "$arg" in
      --advanced) advanced=(--advanced) ;;
      signage|terminal|workstation) profile="$arg" ;;
      *) usage ;;
    esac
  done

  [ ! -e "$CONFIG_FILE" ] || fail "Configuration already exists: $CONFIG_FILE. Edit it, or move it away before running init again."

  mkdir -p "$(dirname "$CONFIG_FILE")"
  (umask 077 && python3 "$CONFIG_LIB" template "$profile" "${advanced[@]}" > "$CONFIG_FILE")

  log "Created $CONFIG_FILE ($profile profile)."
  log "Review it, then run: just apply"
}

main "$@"
