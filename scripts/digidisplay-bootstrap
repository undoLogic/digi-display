#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="DigiDisplay"
DEFAULT_URL="https://www.digi-display.com/en"
CONFIG_FILE="${DIGIDISPLAY_CONFIG:-$HOME/digidisplay.json}"
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SERVICE_TEMPLATE="$REPO_DIR/systemd/digidisplay-user.service"
USER_SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
USER_SERVICE_FILE="$USER_SYSTEMD_DIR/digidisplay.service"
FIREFOX_PROFILE_DIR="${DIGIDISPLAY_FIREFOX_PROFILE:-$HOME/.local/share/digidisplay/firefox-profile}"
FIREFOX_PREFS_SOURCE="$REPO_DIR/config/firefox/user.js"
WALLPAPER_SOURCE="$REPO_DIR/assets/wallpaper/digidisplay-wallpaper.jpg"
WALLPAPER_DEST="$HOME/.local/share/digidisplay/wallpaper.jpg"

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

yes_no() {
  local prompt="$1"
  local default="${2:-yes}"
  local suffix="[Y/n]"
  local answer

  if [ "$default" = "no" ]; then
    suffix="[y/N]"
  fi

  while true; do
    read -r -p "$prompt $suffix " answer
    answer="${answer:-$default}"
    case "${answer,,}" in
      y|yes) return 0 ;;
      n|no) return 1 ;;
      *) log "Please answer yes or no." ;;
    esac
  done
}

prompt_value() {
  local prompt="$1"
  local default="$2"
  local answer

  if [ -z "$default" ]; then
    read -r -p "$prompt: " answer
  else
    read -r -p "$prompt [$default]: " answer
  fi
  printf '%s\n' "${answer:-$default}"
}

prompt_mode() {
  local default="$1"
  local mode

  while true; do
    mode="$(prompt_value "Deployment mode (cloud/local)" "$default")"
    case "${mode,,}" in
      cloud|local)
        printf '%s\n' "${mode,,}"
        return
        ;;
      *) printf 'Please enter cloud or local.\n' >&2 ;;
    esac
  done
}

json_value() {
  local key="$1"
  local fallback="$2"

  if [ ! -f "$CONFIG_FILE" ]; then
    printf '%s\n' "$fallback"
    return
  fi

  python3 - "$CONFIG_FILE" "$key" "$fallback" <<'PY'
import json
import sys
from pathlib import Path

config_path = Path(sys.argv[1])
key = sys.argv[2]
fallback = sys.argv[3]

try:
    data = json.loads(config_path.read_text())
except Exception:
    print(fallback)
    raise SystemExit

value = data
for part in key.split("."):
    if not isinstance(value, dict) or part not in value:
        value = fallback
        break
    value = value[part]
if value is None:
    value = fallback
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

write_config() {
  local mode="$1"
  local url="$2"
  local kiosk="$3"
  local restart_browser="$4"
  local repository="$5"
  local branch="$6"
  local project_path="$7"
  local docker_path="$8"
  local ssh_key="$9"
  local health_url="${10}"

  python3 - "$CONFIG_FILE" "$mode" "$url" "$kiosk" "$restart_browser" \
    "$repository" "$branch" "$project_path" "$docker_path" "$ssh_key" "$health_url" <<'PY'
import json
import sys
from pathlib import Path

config_path = Path(sys.argv[1]).expanduser()
mode = sys.argv[2]
url = sys.argv[3]
kiosk = sys.argv[4] == "true"
restart_browser = sys.argv[5] == "true"
repository = sys.argv[6]
branch = sys.argv[7]
project_path = sys.argv[8]
docker_path = sys.argv[9]
ssh_key = sys.argv[10]
health_url = sys.argv[11]

data = {}
if config_path.exists():
    try:
        data = json.loads(config_path.read_text())
    except Exception:
        data = {}

if not isinstance(data, dict):
    data = {}

previous_mode = data.get("mode", "cloud")
wait_for_network = data.get("wait_for_network", True)
if previous_mode != mode:
    wait_for_network = mode == "cloud"

remote_admin = {
    "tailscale": False,
    "ssh": False,
    "nomachine": False,
}
if isinstance(data.get("remote_admin"), dict):
    remote_admin.update(data.get("remote_admin", {}))

update = {"automatic": False}
if isinstance(data.get("update"), dict):
    update.update(data.get("update", {}))
update["automatic"] = False

data.update({
    "version": 1,
    "mode": mode,
    "url": url,
    "kiosk": kiosk,
    "wait_for_network": wait_for_network,
    "restart_browser": restart_browser,
    "remote_admin": remote_admin,
    "update": update,
})

if mode == "local":
    data["local"] = {
        "repository": repository,
        "branch": branch,
        "project_path": project_path,
        "docker_path": docker_path,
        "ssh_key": ssh_key,
        "health_url": health_url,
    }
else:
    data.pop("local", None)

config_path.parent.mkdir(parents=True, exist_ok=True)
config_path.write_text(json.dumps(data, indent=2) + "\n")
PY
}

check_local_requirements() {
  command -v git >/dev/null 2>&1 || fail "git is required for local mode."
  command -v docker >/dev/null 2>&1 || fail "docker is required for local mode."
  command -v curl >/dev/null 2>&1 || fail "curl is required for local mode."
  docker compose version >/dev/null 2>&1 || fail "Docker Compose is not available."
}

check_environment() {
  if [ -r /etc/os-release ]; then
    if ! grep -Eiq 'aurora|universal.blue|ublue' /etc/os-release; then
      warn "This does not look like Aurora DX. Setup will continue, but testing should happen on Aurora DX."
    fi
  else
    warn "Could not read /etc/os-release to verify Aurora DX."
  fi

  command -v python3 >/dev/null 2>&1 || fail "python3 is required to write $CONFIG_FILE."
  command -v systemctl >/dev/null 2>&1 || fail "systemctl is required for the systemd user service."
}

has_firefox() {
  command -v firefox >/dev/null 2>&1 && return 0
  command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1
}

ensure_firefox() {
  if has_firefox; then
    return
  fi

  warn "Firefox was not found."
  if command -v flatpak >/dev/null 2>&1; then
    if yes_no "Install Firefox from Flathub now?" "yes"; then
      flatpak install -y flathub org.mozilla.firefox
      return
    fi
  fi

  fail "Install Firefox, then run just digidisplay again."
}

install_firefox_profile() {
  mkdir -p "$FIREFOX_PROFILE_DIR"
  cp "$FIREFOX_PREFS_SOURCE" "$FIREFOX_PROFILE_DIR/user.js"

  if command -v flatpak >/dev/null 2>&1 && flatpak info org.mozilla.firefox >/dev/null 2>&1; then
    mkdir -p "$HOME/.var/app/org.mozilla.firefox/digidisplay-profile"
    cp "$FIREFOX_PREFS_SOURCE" "$HOME/.var/app/org.mozilla.firefox/digidisplay-profile/user.js"
  fi
}

install_user_service() {
  local restart_policy="always"
  local escaped_config_file
  local escaped_repo_dir

  if [ "$1" != "true" ]; then
    restart_policy="no"
  fi

  escaped_config_file="$(printf '%s' "$CONFIG_FILE" | sed 's/[&|]/\\&/g')"
  escaped_repo_dir="$(printf '%s' "$REPO_DIR" | sed 's/[&|]/\\&/g')"

  mkdir -p "$USER_SYSTEMD_DIR"
  sed \
    -e "s|@CONFIG_FILE@|$escaped_config_file|g" \
    -e "s|@REPO_DIR@|$escaped_repo_dir|g" \
    -e "s|@RESTART_POLICY@|$restart_policy|g" \
    "$SERVICE_TEMPLATE" > "$USER_SERVICE_FILE"

  systemctl --user daemon-reload
  systemctl --user enable digidisplay.service
}

configure_kde_locking() {
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key LockOnResume false
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig5 --file kscreenlockerrc --group Daemon --key Autolock false
    kwriteconfig5 --file kscreenlockerrc --group Daemon --key LockOnResume false
  else
    warn "KDE screen-lock settings were not changed because kwriteconfig was not found."
  fi
}

configure_kde_power_management() {
  local kwriteconfig=""

  if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig="kwriteconfig6"
  elif command -v kwriteconfig5 >/dev/null 2>&1; then
    kwriteconfig="kwriteconfig5"
  else
    warn "KDE power-management settings were not changed because kwriteconfig was not found."
    return
  fi

  # Plasma's own idle timers (powerdevil) run independently of xset/DPMS and
  # will dim and blank the screen on Wayland even with disable_display_blanking
  # in place, so every power profile needs dimming, screen-off, and suspend
  # disabled directly.
  local profile
  for profile in AC Battery LowBattery; do
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key DimDisplayWhenIdle false
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key DimDisplayIdleTimeoutSec 0
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key TurnOffDisplayWhenIdle false
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key TurnOffDisplayIdleTimeoutSec 0
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key LockBeforeTurnOffDisplay false
    "$kwriteconfig" --file powerdevilrc --group "$profile" --key AutoSuspendIdleTimeoutSec 0
  done

  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files plasma-powerdevil.service >/dev/null 2>&1; then
    systemctl --user restart plasma-powerdevil.service || warn "Could not restart plasma-powerdevil.service. Power settings will apply after next login."
  fi
}

install_wallpaper() {
  if [ ! -f "$WALLPAPER_SOURCE" ]; then
    return
  fi

  mkdir -p "$(dirname "$WALLPAPER_DEST")"
  cp "$WALLPAPER_SOURCE" "$WALLPAPER_DEST"

  if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    if ! plasma-apply-wallpaperimage --fill-mode preserveAspectCrop "$WALLPAPER_DEST" >/dev/null 2>&1; then
      warn "Could not set the desktop wallpaper automatically. You can set it manually via System Settings."
    fi
  else
    warn "plasma-apply-wallpaperimage was not found. Skipping automatic wallpaper setup."
  fi
}

detect_login_manager() {
  local dm_unit
  dm_unit="$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)"
  case "$dm_unit" in
    */plasmalogin.service) printf 'plasmalogin\n' ;;
    */sddm.service) printf 'sddm\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

configure_autologin() {
  if ! command -v sudo >/dev/null 2>&1; then
    warn "sudo was not found. Skipping autologin setup."
    return
  fi

  local session="plasma.desktop"
  if [ -f /usr/share/wayland-sessions/plasma.desktop ]; then
    session="plasma.desktop"
  elif [ -f /usr/share/xsessions/plasma.desktop ]; then
    session="plasma.desktop"
  fi

  local login_manager
  login_manager="$(detect_login_manager)"

  local conf_dir
  case "$login_manager" in
    plasmalogin) conf_dir="/etc/plasmalogin.conf.d" ;;
    sddm) conf_dir="/etc/sddm.conf.d" ;;
    *)
      warn "Could not detect sddm or plasmalogin as the active login manager. Skipping autologin setup."
      return
      ;;
  esac

  local tmp_file
  tmp_file="$(mktemp)"
  cat > "$tmp_file" <<EOF
[Autologin]
User=$USER
Session=$session
EOF

  sudo mkdir -p "$conf_dir"
  sudo cp "$tmp_file" "$conf_dir/digidisplay-autologin.conf"
  rm -f "$tmp_file"
}

main() {
  log "$APP_NAME setup"
  log

  check_environment
  ensure_firefox

  local current_mode
  local current_url
  local current_kiosk
  local current_restart
  local mode
  local url
  local kiosk="true"
  local restart_browser="true"
  local repository=""
  local branch="main"
  local project_path="~/DigiDisplay/projects/client-project"
  local docker_path="docker-wsl"
  local ssh_key=""
  local health_url="http://localhost/"

  current_mode="$(json_value "mode" "cloud")"
  current_url="$(json_value "url" "$DEFAULT_URL")"
  current_kiosk="$(json_value "kiosk" "true")"
  current_restart="$(json_value "restart_browser" "true")"

  mode="$(prompt_mode "$current_mode")"

  if [ "$mode" != "$current_mode" ]; then
    if [ "$mode" = "local" ]; then
      current_url="http://localhost"
    else
      current_url="$DEFAULT_URL"
    fi
  fi

  if [ "$mode" = "local" ]; then
    repository="$(prompt_value "Git repository" "$(json_value "local.repository" "")")"
    branch="$(prompt_value "Git branch" "$(json_value "local.branch" "$branch")")"
    project_path="$(prompt_value "Local project path" "$(json_value "local.project_path" "$project_path")")"
    docker_path="$(prompt_value "Docker Compose directory inside the project" "$(json_value "local.docker_path" "$docker_path")")"
    ssh_key="$(prompt_value "SSH private key (leave blank for a public repository)" "$(json_value "local.ssh_key" "$ssh_key")")"
    health_url="$(prompt_value "Local health URL" "$(json_value "local.health_url" "$health_url")")"

    [ -n "$repository" ] || fail "A Git repository is required for local mode."
    [ -n "$project_path" ] || fail "A local project path is required for local mode."
    [ -n "$docker_path" ] || fail "A Docker Compose directory is required for local mode."
    case "$health_url" in
      http://*|https://*) ;;
      *) fail "The local health URL must start with http:// or https://." ;;
    esac
    check_local_requirements
  fi

  url="$(prompt_value "Display URL" "$current_url")"
  case "$url" in
    http://*|https://*) ;;
    *) warn "The display URL does not start with http:// or https://." ;;
  esac

  if yes_no "Launch Firefox in kiosk mode?" "$([ "$current_kiosk" = "true" ] && printf yes || printf no)"; then
    kiosk="true"
  else
    kiosk="false"
  fi

  if yes_no "Restart Firefox automatically if it closes?" "$([ "$current_restart" = "true" ] && printf yes || printf no)"; then
    restart_browser="true"
  else
    restart_browser="false"
  fi

  write_config "$mode" "$url" "$kiosk" "$restart_browser" \
    "$repository" "$branch" "$project_path" "$docker_path" "$ssh_key" "$health_url"
  install_firefox_profile
  install_user_service "$restart_browser"
  configure_kde_locking
  configure_kde_power_management
  install_wallpaper

  if yes_no "Enable desktop autologin for this user?" "yes"; then
    configure_autologin
  fi

  log
  log "Setup complete."
  log "Config: $CONFIG_FILE"
  log "Service: $USER_SERVICE_FILE"
  log
  log "Use 'just digidisplay-status' to inspect the service."

  if yes_no "Reboot now?" "no"; then
    systemctl reboot
  else
    log "Reboot when ready to start the kiosk automatically."
  fi
}

main "$@"
