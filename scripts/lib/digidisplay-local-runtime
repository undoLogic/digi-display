#!/usr/bin/env bash
# Local mode: the app is cloned to ~/digidisplay-webroot and started with the
# SetupCase Core convention dockerLinux/1startDocker.sh. Source it after
# digidisplay-common and load_settings.

WEBROOT_DIR="${DIGIDISPLAY_WEBROOT:-$HOME/digidisplay-webroot}"
START_SCRIPT_DIR="dockerLinux"
START_SCRIPT="1startDocker.sh"
DEPLOY_KEY_FILE="$HOME/.ssh/digidisplay-deploy-key"

# Writes local.deploy_key to its own file (git needs a file); removes it when the key is not set.
install_deploy_key() {
  local deploy_key
  deploy_key="$(config_get local.deploy_key)"

  if [ -z "$deploy_key" ]; then
    rm -f -- "$DEPLOY_KEY_FILE"
    return
  fi

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  (umask 077 && printf '%s\n' "$deploy_key" > "$DEPLOY_KEY_FILE")
  log "Deploy key installed: $DEPLOY_KEY_FILE"
}

local_git() {
  local ssh_command

  if [ ! -f "$DEPLOY_KEY_FILE" ]; then
    git "$@"
    return
  fi

  printf -v ssh_command 'ssh -i %q -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new' "$DEPLOY_KEY_FILE"
  GIT_SSH_COMMAND="$ssh_command" git "$@"
}

ensure_local_repository() {
  if [ -d "$WEBROOT_DIR/.git" ]; then
    log "Using existing local repository: $WEBROOT_DIR"
    return
  fi

  [ ! -e "$WEBROOT_DIR" ] || fail "$WEBROOT_DIR exists but is not a Git repository. Move it away and try again."

  log "Cloning $DD_LOCAL_REPOSITORY ($DD_LOCAL_BRANCH) into $WEBROOT_DIR"
  local_git clone --branch "$DD_LOCAL_BRANCH" --single-branch -- "$DD_LOCAL_REPOSITORY" "$WEBROOT_DIR"
}

update_local_repository() {
  ensure_local_repository

  if ! git -C "$WEBROOT_DIR" diff --quiet || ! git -C "$WEBROOT_DIR" diff --cached --quiet; then
    fail "Local repository has tracked changes. Commit or remove them before updating."
  fi

  log "Fetching $DD_LOCAL_BRANCH from $DD_LOCAL_REPOSITORY"
  local_git -C "$WEBROOT_DIR" fetch -- "$DD_LOCAL_REPOSITORY" "$DD_LOCAL_BRANCH"

  if [ "$(git -C "$WEBROOT_DIR" branch --show-current)" != "$DD_LOCAL_BRANCH" ]; then
    if git -C "$WEBROOT_DIR" show-ref --verify --quiet "refs/heads/$DD_LOCAL_BRANCH"; then
      git -C "$WEBROOT_DIR" checkout "$DD_LOCAL_BRANCH"
    else
      git -C "$WEBROOT_DIR" checkout -b "$DD_LOCAL_BRANCH" FETCH_HEAD
    fi
  fi

  git -C "$WEBROOT_DIR" merge --ff-only FETCH_HEAD
}

start_local_runtime() {
  local script_dir="$WEBROOT_DIR/$START_SCRIPT_DIR"

  [ -f "$script_dir/$START_SCRIPT" ] || fail "Start script not found: $script_dir/$START_SCRIPT. Local projects must provide $START_SCRIPT_DIR/$START_SCRIPT."

  log "Starting local Docker runtime: $script_dir/$START_SCRIPT"
  (cd "$script_dir" && bash "./$START_SCRIPT")
}

# Polls the top-level url until the local app answers.
wait_for_local_health() {
  local attempts="${DIGIDISPLAY_HEALTH_ATTEMPTS:-60}"
  local interval="${DIGIDISPLAY_HEALTH_INTERVAL:-2}"
  local attempt

  log "Waiting for local application: $DD_URL"
  for ((attempt = 1; attempt <= attempts; attempt += 1)); do
    if curl --fail --silent --output /dev/null --max-time 5 "$DD_URL"; then
      log "Local application is ready."
      return
    fi
    [ "$attempt" -lt "$attempts" ] && sleep "$interval"
  done

  fail "Local application did not answer after $attempts attempts: $DD_URL"
}

prepare_local_runtime() {
  ensure_local_repository
  start_local_runtime
  wait_for_local_health
}
