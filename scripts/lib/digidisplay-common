#!/usr/bin/env bash
# Shared by every scripts/digidisplay-* command. Source it; do not run it.

REPO_DIR="${DIGIDISPLAY_REPO_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"
CONFIG_FILE="${DIGIDISPLAY_CONFIG:-$HOME/digidisplay.json}"
BACKUP_DIR="$(dirname "$CONFIG_FILE")/digidisplay-backups"
CONFIG_LIB="$REPO_DIR/scripts/lib/digidisplay-config"
# DIGIDISPLAY_SERVER picks the cloud server for login and pull: production (default), staging, or a full URL.
case "${DIGIDISPLAY_SERVER:-production}" in
  production) SERVER_URL="https://site2.digi-display.com" ;;
  staging) SERVER_URL="https://site2staging.digi-display.com" ;;
  *) SERVER_URL="${DIGIDISPLAY_SERVER%/}" ;;
esac
SERVICE_NAME="digidisplay.service"
export DIGIDISPLAY_CONFIG="$CONFIG_FILE"

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Prints a path with the home folder as ~ (Aurora homes are /var/home/<user>, which reads like a subfolder).
show_path() {
  local path="$1"
  if [[ "$path" == "$HOME"/* ]]; then
    path="~/${path#"$HOME"/}"
  fi
  printf '%s' "$path"
}

# Explains a failed server request. Never pass a response that contains a token.
explain_http_failure() {
  local url="$1"
  local code="$2"
  local redirect="$3"
  local body_file="$4"

  warn "Request: POST $url"
  warn "HTTP status: $code"
  [ -z "$redirect" ] || warn "Redirected to: $redirect"
  if [ -s "$body_file" ]; then
    warn "Server response (first 500 characters):"
    head -c 500 "$body_file" >&2
    printf '\n' >&2
  fi

  case "$code" in
    000) warn "Hint: no response. Check the network, DNS, and the server's TLS certificate (curl's message is above)." ;;
    30?) warn "Hint: the server redirected instead of answering. POST routes must answer directly; check the route (for example a language prefix) and DIGIDISPLAY_SERVER." ;;
    400) warn "Hint: the server rejected the request body. Check the JSON fields it expects." ;;
    401) warn "Hint: the server rejected the email and password, or the token. For a token, run 'just login' again on this server." ;;
    403) warn "Hint: forbidden. Check that CSRF protection is skipped for this route and that it is public (no session needed)." ;;
    404) warn "Hint: this route does not exist on $SERVER_URL. Check the server code is deployed there, and that DIGIDISPLAY_SERVER is right (production or staging)." ;;
    405) warn "Hint: the route exists but does not accept POST." ;;
    5??) warn "Hint: server error. Check the server's error log." ;;
  esac
}

# Sets the DD_* variables from the resolved configuration, or exits on an invalid file.
load_settings() {
  local settings
  settings="$(python3 "$CONFIG_LIB" shell)" || exit 1
  eval "$settings"
}

config_get() {
  python3 "$CONFIG_LIB" get "$1"
}

# Restricts the active config, the backup folder, and every backup in it to the owner.
protect_config_files() {
  chmod 600 "$CONFIG_FILE"
  [ -d "$BACKUP_DIR" ] || return 0
  chmod 700 "$BACKUP_DIR"
  find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.json' -exec chmod 600 {} +
}
