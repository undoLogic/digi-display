#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"

DOWNLOAD_FILE="$CONFIG_FILE.download"

backup_path() {
  printf '%s/%s-%s.json\n' "$(dirname "$CONFIG_FILE")" "$(basename "$CONFIG_FILE" .json)" "$(date '+%Y_%m_%d_%H_%M_%S')"
}

cleanup() {
  rm -f -- "$DOWNLOAD_FILE"
}

# The token goes in a header file, not on the command line, so it stays out of the process list.
download_config() {
  local token="$1"

  curl --fail --silent --show-error --location \
    --header @<(printf 'Authorization: Bearer %s\nAccept: application/json\n' "$token") \
    --output "$DOWNLOAD_FILE" "$SERVER_URL/configure"
}

main() {
  local token
  local saved_backup=""

  [ "$#" -eq 0 ] || fail "Usage: just pull"
  command -v curl >/dev/null 2>&1 || fail "curl is required to download the configuration."
  [ -f "$CONFIG_FILE" ] || fail "No configuration found. Run 'just login' first."
  token="$(config_get token)"
  [ -n "$token" ] || fail "No token in $CONFIG_FILE. Run 'just login' first."

  trap cleanup EXIT
  log "Downloading configuration from $SERVER_URL/configure"
  (umask 077 && download_config "$token")
  python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$DOWNLOAD_FILE" 2>/dev/null \
    || fail "The server response was not valid JSON. The current configuration was not changed."

  saved_backup="$(backup_path)"
  mv -f -- "$CONFIG_FILE" "$saved_backup"
  mv -f -- "$DOWNLOAD_FILE" "$CONFIG_FILE" \
    || fail "Could not install the downloaded configuration. The previous file is at $saved_backup"
  trap - EXIT
  protect_config_files

  log "Backup: $saved_backup"
  log "Configuration saved: $CONFIG_FILE"
  log "Run: just apply"
}

main "$@"
