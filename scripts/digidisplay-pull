#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=scripts/lib/digidisplay-common
source "$(dirname "${BASH_SOURCE[0]}")/lib/digidisplay-common"

DOWNLOAD_FILE="$CONFIG_FILE.download"
PULL_URL="$SERVER_URL/digiDisplayConfigure"

backup_path() {
  printf '%s/%s-%s.json\n' "$BACKUP_DIR" "$(basename "$CONFIG_FILE" .json)" "$(date '+%Y_%m_%d_%H_%M_%S')"
}

cleanup() {
  rm -f -- "$DOWNLOAD_FILE"
}

# POST, because the server records this box's hostname and pull time.
# The token goes in a header file, not on the command line, so it stays out of the process list.
download_config() {
  local token="$1"

  local result
  local code
  local redirect

  result="$(python3 -c 'import json, sys; print(json.dumps({"hostname": sys.argv[1]}))' "$(hostname)" \
    | curl --silent --show-error \
        --header @<(printf 'Authorization: Bearer %s\nAccept: application/json\nContent-Type: application/json\n' "$token") \
        --output "$DOWNLOAD_FILE" --write-out '%{http_code} %{redirect_url}' \
        --data @- "$PULL_URL")" || true
  code="${result%% *}"
  redirect="${result#* }"

  if [[ "$code" != 2?? ]]; then
    explain_http_failure "$PULL_URL" "$code" "$redirect" "$DOWNLOAD_FILE"
    return 1
  fi
}

main() {
  local token
  local saved_backup=""

  [ "$#" -eq 0 ] || fail "Usage: just pull"
  command -v curl >/dev/null 2>&1 || fail "curl is required to download the configuration."
  [ -f "$CONFIG_FILE" ] || fail "No configuration found. Run 'just login' first."
  token="$(config_get token)"
  [ -n "$token" ] || fail "No token in $(show_path "$CONFIG_FILE"). Run 'just login' first."

  trap cleanup EXIT
  log "Cloud server: $SERVER_URL"
  log "Downloading configuration: POST $PULL_URL"
  (umask 077 && download_config "$token") || fail "Pull failed. The current configuration was not changed."
  python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$DOWNLOAD_FILE" 2>/dev/null \
    || fail "The server response was not valid JSON. The current configuration was not changed."

  mkdir -p -m 700 "$BACKUP_DIR"
  saved_backup="$(backup_path)"
  mv -f -- "$CONFIG_FILE" "$saved_backup"
  mv -f -- "$DOWNLOAD_FILE" "$CONFIG_FILE" \
    || fail "Could not install the downloaded configuration. The previous file is at $(show_path "$saved_backup")"
  trap - EXIT
  protect_config_files

  log "Backup: $(show_path "$saved_backup")"
  log "Configuration saved: $(show_path "$CONFIG_FILE")"
  log "Run: just apply"
}

main "$@"
