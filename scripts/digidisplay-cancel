#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE_NAME="digidisplay.service"

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user list-unit-files "$SERVICE_NAME" >/dev/null 2>&1; then
    systemctl --user stop "$SERVICE_NAME" || warn "Could not stop $SERVICE_NAME."
  else
    warn "$SERVICE_NAME was not found for this user."
  fi
else
  warn "systemctl was not found."
fi

# The flatpak-sandboxed browser runs as "firefox" (main process) plus
# several "firefox-bin" content processes, so both names must be matched.
FIREFOX_NAMES=(firefox firefox-bin firefox-esr)

firefox_running() {
  local name
  for name in "${FIREFOX_NAMES[@]}"; do
    pgrep -x "$name" >/dev/null 2>&1 && return 0
  done
  return 1
}

if firefox_running; then
  log "Killing Firefox..."
  for name in "${FIREFOX_NAMES[@]}"; do
    pkill -x "$name" 2>/dev/null || true
  done
else
  log "Firefox was not running."
fi

log "DigiDisplay kiosk cancelled."
